PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/neurostack
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173

# --- LLM (Claude). Leave empty to run in demo mode (no LLM calls) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
ENABLE_CRITIC=true

# --- Embeddings: local (no key, works offline) | openai ---
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store: mongo | atlas | pinecone ---
VECTOR_STORE=mongo
ATLAS_VECTOR_INDEX=chunk_vector_index
PINECONE_API_KEY=
PINECONE_INDEX_HOST=

# --- Optional: keep original uploads in S3 ---
S3_BUCKET=
AWS_REGION=ap-south-1
